# MyPresence — template .env pengembangan lokal. Salin ke .env lalu `php artisan key:generate`.
# Template produksi: deploy/env.production.example · cPanel: deploy/cpanel/env.cpanel.example
APP_NAME=MyPresence
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://mypresence.localhost:8000
APP_DOMAIN=mypresence.localhost
APP_VERSION=dev
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file
TRUSTED_PROXIES=

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mypresence
DB_USERNAME=root
DB_PASSWORD=

CACHE_STORE=database
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@mypresence.localhost"
MAIL_FROM_NAME="MyPresence"

FILESYSTEM_DISK=local
TENANT_FILES_DISK=local
BACKUP_DISK=local
BACKUP_PASSWORD=
BACKUP_KEEP=14

SUPERADMIN_PASSWORD=
SUPERADMIN_2FA=false
SCHOOL_ADMIN_2FA=false
PANEL_ALLOWED_IPS=

LEGAL_DRAFT=true
BILLING_PRICE_PER_STUDENT=3000
PAYMENT_GATEWAY=manual

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

HEALTH_TOKEN=
OPS_ALERT_EMAIL=
