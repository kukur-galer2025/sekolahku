# ════════════════════════════════════════════════════════════════
#  MyPresence — .env untuk SHARED HOSTING (cPanel)
#  Letak: /home/USER/mypresence/.env   (di LUAR public_html)
#  Yang WAJIB Bro ubah ditandai  "↓ UBAH" (baris di bawahnya)
#  APP_KEY, HEALTH_TOKEN, BACKUP_PASSWORD sudah dibuatkan acak — JANGAN dibagikan.
# ════════════════════════════════════════════════════════════════
APP_NAME=MyPresence
APP_ENV=production
APP_DEBUG=false
APP_KEY=__APP_KEY__
APP_URL=https://mypresence.id
APP_DOMAIN=mypresence.id
APP_VERSION=cpanel-1
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file

# Cloudflare (Proxied/awan oranye): IP Cloudflare dipercaya agar IP asli siswa terbaca
# untuk cek WiFi sekolah. Daftar dari https://www.cloudflare.com/ips/ (diperbarui 28 Sep 2023).
TRUSTED_PROXIES=173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22,2400:cb00::/32,2606:4700::/32,2803:f800::/32,2405:b500::/32,2405:8100::/32,2a06:98c0::/29,2c0f:f248::/32

BCRYPT_ROUNDS=12
LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# Database dari cPanel → MySQL Databases (nama biasanya berawalan user cPanel, mis. abcd_mypresence)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
# ↓ UBAH
DB_DATABASE=USERCPANEL_mypresence
# ↓ UBAH
DB_USERNAME=USERCPANEL_mypresence
# ↓ UBAH
DB_PASSWORD=

# Shared hosting: tanpa Redis → sesi, cache, antrean di database
CACHE_STORE=database
QUEUE_CONNECTION=database
QUEUE_VIA_SCHEDULER=false
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
# HARUS null: cookie sesi terikat ke satu subdomain sekolah
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# Email dari hosting: cPanel → Email Accounts → buat noreply@mypresence.id
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.mypresence.id
MAIL_PORT=465
MAIL_USERNAME=noreply@mypresence.id
# ↓ UBAH
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@mypresence.id"
MAIL_FROM_NAME="MyPresence"

TENANT_FILES_DISK=local
BACKUP_DISK=local
# Sandi backup terenkripsi. SIMPAN juga di catatan aman — tanpa ini backup tidak bisa dibuka.
BACKUP_PASSWORD=__BACKUP_PASSWORD__
BACKUP_KEEP=7

SUPERADMIN_2FA=true
# Diisi SEMENTARA saat membuat akun super-admin lewat Cron (langkah 8), lalu dikosongkan lagi.
SUPERADMIN_PASSWORD=
PANEL_ALLOWED_IPS=

LEGAL_DRAFT=true
LEGAL_COMPANY="Parama Tech"
LEGAL_ADDRESS=
LEGAL_EMAIL=privasi@mypresence.id

# ↓ tentukan harga final
BILLING_PRICE_PER_STUDENT=3000
BILLING_MIN_STUDENTS=50
BILLING_TAX_PERCENT=0
BILLING_GRACE_DAYS=7
PAYMENT_GATEWAY=manual
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_PRODUCTION=true
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
BILLING_BANK_NAME=
BILLING_BANK_ACCOUNT=
BILLING_BANK_HOLDER=
BILLING_SELLER_NAME="Parama Tech"
BILLING_SELLER_ADDRESS=
BILLING_SELLER_EMAIL=billing@mypresence.id
BILLING_SELLER_PHONE=
BILLING_SELLER_NPWP=

# Monitor uptime: https://mypresence.id/health?token=<HEALTH_TOKEN>
HEALTH_TOKEN=__HEALTH_TOKEN__
# ↓ email Bro untuk notifikasi error
OPS_ALERT_EMAIL=
