# ════════════════════════════════════════════════════════════════
#  MyPresence — .env PRODUKSI  →  /var/www/mypresence/shared/.env
#  Isi semua yang bertanda [WAJIB]. File ini berisi rahasia: chmod 640.
# ════════════════════════════════════════════════════════════════
APP_NAME=MyPresence
APP_ENV=production
APP_DEBUG=false
# [WAJIB] php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=
APP_URL=https://mypresence.id
APP_DOMAIN=mypresence.id
APP_VERSION=
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file
# Kosongkan bila Nginx langsung menerima koneksi. Bila Cloudflare "Proxied": isi daftar IP Cloudflare
# (https://www.cloudflare.com/ips/) — kalau tidak, cek WiFi sekolah menolak semua siswa. JANGAN isi "*".
TRUSTED_PROXIES=

BCRYPT_ROUNDS=12
LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# [WAJIB] dari /root/mypresence-db.txt (dibuat provision.sh)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mypresence
DB_USERNAME=mypresence
DB_PASSWORD=

# Redis untuk sesi, cache, dan antrean (dipasang provision.sh, hanya localhost)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
# HARUS null: cookie sesi terikat ke satu subdomain sekolah (isolasi tenant).
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# [WAJIB] SMTP untuk verifikasi email, lupa password, tagihan (Brevo/Mailgun/Zoho/Google Workspace, dll.)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@mypresence.id"
MAIL_FROM_NAME="MyPresence"

# Berkas sekolah & backup: local (di VPS) atau s3 (IDCloudHost/Wasabi/Cloudflare R2/MinIO)
TENANT_FILES_DISK=local
BACKUP_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
# [WAJIB] sandi AES-256 backup per sekolah & dump database. Simpan juga di password manager.
BACKUP_PASSWORD=
BACKUP_KEEP=14

# Panel super-admin
SUPERADMIN_2FA=true
# Opsional: batasi /panel ke IP kantor, pisahkan koma
PANEL_ALLOWED_IPS=

# Dokumen hukum — ubah LEGAL_DRAFT=false setelah ditinjau konsultan hukum
LEGAL_DRAFT=true
LEGAL_COMPANY="Parama Tech"
LEGAL_ADDRESS=
LEGAL_EMAIL=privasi@mypresence.id

# Langganan & pembayaran — [WAJIB] tentukan harga final
BILLING_PRICE_PER_STUDENT=3000
BILLING_MIN_STUDENTS=50
BILLING_TAX_PERCENT=0
BILLING_GRACE_DAYS=7
PAYMENT_GATEWAY=manual
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_PRODUCTION=true
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
BILLING_BANK_NAME=
BILLING_BANK_ACCOUNT=
BILLING_BANK_HOLDER=
BILLING_SELLER_NAME="Parama Tech"
BILLING_SELLER_ADDRESS=
BILLING_SELLER_EMAIL=billing@mypresence.id
BILLING_SELLER_PHONE=
BILLING_SELLER_NPWP=

# Monitoring — [WAJIB] token acak: openssl rand -hex 24
HEALTH_TOKEN=
OPS_ALERT_EMAIL=
